{
  "name": "ebuch-konvertierung-frontend",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:backend": "PYTHONUNBUFFERED=1 PYTHONPATH=. .venv/bin/uvicorn backend.main:app --port 8000 --reload",
    "dev:frontend": "vite",
    "dev:all": "concurrently -k -n \"backend,frontend\" -c \"blue,cyan\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "start": "npm run dev:all",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint frontend/src --max-warnings 0",
    "lint:py": "ruff check backend/services/fibs_constants.py backend/services/prompts.py backend/services/models.py backend/services/fibs_formatting.py backend/services/fibs_postprocess.py backend/services/llm_service.py backend/services/a11y_linter.py backend/services/feedback_service.py backend/services/docx_service.py backend/services/formula_service.py",
    "dead-code": ".venv/bin/vulture backend --min-confidence 90 --exclude backend/tests",
    "test:e2e": "playwright test",
    "test:pipeline": "RUN_PIPELINE=true playwright test frontend/tests/pipeline-integration.spec.ts",
    "test:benchmark": "RUN_BENCHMARK=true playwright test",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "concurrently": "^10.0.5",
    "eslint": "^10.11.0",
    "husky": "^9.1.7",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^5.4.21"
  }
}
